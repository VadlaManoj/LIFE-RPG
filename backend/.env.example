OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LIFE_RPG_SECRET=replace-with-a-long-random-secret

# =============================================================================
# Phase 3: Real Integrations Configuration
# =============================================================================

# GitHub OAuth App Credentials
# Create at: https://github.com/settings/developers -> New OAuth App
# - Application name: LIFE RPG
# - Homepage URL: http://localhost:5173
# - Authorization callback URL: http://localhost:5173/integrations
# Minimum scopes used: read:user, repo
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/integrations

# Google Calendar OAuth 2.0 Web Application Credentials
# Create at: https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth client ID
# - Application type: Web application
# - Authorized JavaScript origins: http://localhost:5173
# - Authorized redirect URIs: http://localhost:5173/integrations
# Enable APIs: Google Calendar API
# Scopes: https://www.googleapis.com/auth/calendar.events.readonly, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations

# Android Health Connect Bridge Configuration
HEALTH_CONNECT_BRIDGE_ENABLED=true
